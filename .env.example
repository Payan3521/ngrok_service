# Token de autenticación de ngrok (obligatorio)
# Obtén el tuyo en: https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=

# Puerto de tu servicio local que quieres exponer a internet
APP_PORT=3000

# Dominio personalizado de ngrok (opcional, requiere plan pago o dominio reservado gratis)
# Ejemplo: mi-app.ngrok-free.app  o  tunel.midominio.com
# Déjalo vacío para usar un dominio aleatorio gratuito
NGROK_DOMAIN=